BORLANDC = D:
CC=$(BORLANDC)\BIN\BCC.EXE
TLINK=$(BORLANDC)\BIN\TLINK.EXE
CFLAGS=-mm -O1 -IINCLUDE -I$(BORLANDC)\INCLUDE

OBJS = MAIN.OBJ SCREEN.OBJ DIS.OBJ CPU.OBJ CPU_TR.OBJ MEM.OBJ BRK.OBJ LOAD.OBJ SYM.OBJ CMDS.OBJ INT21.OBJ HELP.OBJ XMSCALL.OBJ

TR.EXE: $(OBJS)
	$(TLINK) /l$(BORLANDC)\LIB $(BORLANDC)\LIB\c0m+main+screen+dis+cpu+cpu_tr+mem+brk+load+sym+cmds+int21+help+xmscall,TR.EXE,,$(BORLANDC)\LIB\cm

XMSCALL.OBJ: SRC\XMSCALL.ASM
	$(BORLANDC)\BIN\TASM SRC\XMSCALL.ASM,XMSCALL.OBJ

MAIN.OBJ: SRC\MAIN.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oMAIN.OBJ SRC\MAIN.CPP

SCREEN.OBJ: SRC\SCREEN.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oSCREEN.OBJ SRC\SCREEN.CPP

DIS.OBJ: SRC\DIS.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oDIS.OBJ SRC\DIS.CPP

CPU.OBJ: SRC\CPU.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oCPU.OBJ SRC\CPU.CPP

CPU_TR.OBJ: SRC\CPU_TR.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oCPU_TR.OBJ SRC\CPU_TR.CPP

MEM.OBJ: SRC\MEM.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oMEM.OBJ SRC\MEM.CPP

BRK.OBJ: SRC\BRK.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oBRK.OBJ SRC\BRK.CPP

LOAD.OBJ: SRC\LOAD.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oLOAD.OBJ SRC\LOAD.CPP

SYM.OBJ: SRC\SYM.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oSYM.OBJ SRC\SYM.CPP

CMDS.OBJ: SRC\CMDS.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oCMDS.OBJ SRC\CMDS.CPP

INT21.OBJ: SRC\INT21.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oINT21.OBJ SRC\INT21.CPP

HELP.OBJ: SRC\HELP.CPP INCLUDE\TR.H
	$(CC) $(CFLAGS) -c -oHELP.OBJ SRC\HELP.CPP
